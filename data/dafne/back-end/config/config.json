{
	"logger": {
		"zippedArchive": false,
		"maxSize": "50m",
		"severity": "info",
		"logname": "dafne-be--%DATE%.log",
		"datePattern": "YYYY-MM-DD"
	},
	"production": {
		"username": "<dafne-db-username>",
		"password": "<dafne-db-password>",
		"database": "dafne",
		"host": "<host>",
		"port": "5432",
		"dialect": "postgres",
		"operatorsAliases": 0
	},
  "report": {
    "username": "<report-username>",
    "password": "<report-password>",
    "reportBackendBaseurl": "http://<report-be-url>:<report-be-port>",
    "checkSingleDayUrl": "/reports/check-report/:day",
    "getSingleDayReportJsonUrl": "/reports/get-report/:day",
    "getReportJsonForPeriodUrl": "/reports/get-report-json-for-period",
    "reportsStorageFolder": "DAFNE_REPORTS",
    "deleteReportsCronSchedule": "0 */4 * 1 *"
  },
	"crypto": {
		"symmetric": {
			"secret": "",
			"algorithm": ""
		}
	},
	"auth": {
		"keycloakBaseUrl": "https://<keycloak_url>/auth/realms/dhus/protocol/openid-connect",
		"clientId": "dafne",
		"grantType": "password"
	},
  "availability": {
    "schedule": "*/10 * * * *",
    "enablePurge": true,
    "purgeSchedule": "0 1 * * *",
    "rollingPeriodInDays": 90,
    "url": "/Products?$top=1"
  },
  "timeliness": {
    "schedule": "0 * * * *",
    "enablePurge": true,
    "purgeSchedule": "0 1 * * *",
    "rollingPeriodInDays": 90
  },
  "ingesters": {
    "datastores": {
      "typeList": [
        {"type": "HFS", "url": "hfs"},
        {"type": "SWIFT", "url": "swift"},
        {"type": "SWIFT_GROUP", "url": "swiftgroup"},
        {"type": "S3", "url": "s3"},
        {"type": "S3_GROUP", "url": "s3group"},
        {"type": "TIME_GROUP", "url": "timebased"}
      ]
    },
    "credentials": {
      "typeList": [
        {"type": "SWIFT", "url": "swiftcredentials"},
        {"type": "S3", "url": "s3credentials"}
      ]
    }
  },
	"requestTimeout": 30000,
	"dataSourceStatus": [
		"RUNNING",
		"PENDING"
	],
	"version": "4.3.1",
	"port": 2000,
	"adminRole": "DATAFLOW_MANAGER",
	"viewerRole": "DATAFLOW_VIEWER"
}